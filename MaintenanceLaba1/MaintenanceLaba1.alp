					<Id>1788727808264</Id>
					<Name><![CDATA[setTransportBase]]></Name>
					<X>-640</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for(Helicopter h:helicopters)
{
 h.setLocation(center);
}
for(Truck t: trucks)
{
 t.setLocation(center);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Transport]]></ReturnType>
					<Id>1788729543066</Id>
					<Name><![CDATA[findTransport]]></Name>
					<X>-640</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[request]]></Name>
						<Type><![CDATA[ServiceRequest]]></Type>
					</Parameter>
					<Body><![CDATA[for (Transport t: request.type == AUTO ? trucks : helicopters)
{
  if(t.inState(Transport.AtCenter))
  {
  return t;
  }

}

return null;]]></Body>
				</Function>
			</Functions>

